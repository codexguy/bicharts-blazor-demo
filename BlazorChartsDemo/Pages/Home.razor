@page "/"

<PageTitle>State Store Sales</PageTitle>

<h1>State store sales</h1>
<p class="lede">
    Revenue, orders and return rate for the 50 US states plus DC. Click a state on the map or a
    bubble on the chart to filter the other. Ctrl-click (Cmd-click on a Mac) adds to the selection;
    ctrl-click a selected mark to remove just that one.
</p>
<p class="credit">
    Two charts generated by RegiaBI through its MCP server, committed to this repo as source,
    running in a plain Blazor WebAssembly app. No Power BI, and no call to us at run time.
    <a href="https://bizintelligencechampions.com/regiabi/developers?loc=ghblz">RegiaBI for developers</a>
    &middot;
    <a href="https://github.com/codexguy/bicharts-blazor-demo">Source</a>
</p>

<BicChartGroup Source="charts/map/data.sample.json" OnSelection="OnSelection" @ref="group">
    <div class="toolbar">
        <button data-bic-clear disabled="@(!hasSelection)" @onclick="() => group!.ClearAsync()">
            Clear selection
        </button>

        <label class="restyle">
            Map colour:
            <select data-bic-restyle @onchange="OnPaletteChanged">
                <option value="blue">Blue</option>
                <option value="green">Green</option>
                <option value="orange">Orange</option>
                <option value="purple">Purple</option>
            </select>
        </label>

        <span class="selection-count">@(hasSelection ? $"{selectedCount} state(s) selected" : "No selection")</span>
    </div>

    <div class="chart-grid">
        <div class="chart-card">
            <h2>Revenue by state</h2>
            <BicChart Id="map" Dir="charts/map" Height="480" RespondsWith="highlight" GeoKind="us-state-name" @ref="map" />
        </div>
        <div class="chart-card">
            <h2>Revenue vs return rate (bubble size = orders, colour = region)</h2>
            <BicChart Id="bubble" Dir="charts/bubble" Height="420" @ref="bubble" />
        </div>
    </div>
</BicChartGroup>

@code {
    BicChartGroup? group;
    BicChart? map;
    BicChart? bubble;
    int selectedCount;
    bool hasSelection => selectedCount > 0;

    static readonly Dictionary<string, (string Low, string High)> Palettes = new()
    {
        ["blue"] = ("#f7fbff", "#08306b"),
        ["green"] = ("#f7fcf5", "#00441b"),
        ["orange"] = ("#fff5eb", "#7f2704"),
        ["purple"] = ("#fcfbfd", "#3f007d"),
    };

    void OnSelection((string? SourceId, int[] Rows) s)
    {
        selectedCount = s.Rows.Length;
        StateHasChanged();
    }

    async Task OnPaletteChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString() ?? "blue";
        if (map is not null && Palettes.TryGetValue(key, out var c))
        {
            await map.SetOptionsAsync(new { colorScaleLow = c.Low, colorScaleHigh = c.High });
        }
    }
}
